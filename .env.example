# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty to use SQLite, or point at PostgreSQL:
# DATABASE_URL=postgres://astonbundle:astonbundle@localhost:5432/astonbundle
DATABASE_URL=
